{
  "name": "transform-ventures",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build:components": "babel components --out-dir dist/components --presets=@babel/preset-react --extensions .jsx",
    "build:pages": "babel pages-src --out-dir dist/pages-src --presets=@babel/preset-react --extensions .jsx",
    "build": "npm run build:components && npm run build:pages",
    "seed": "node server/seed.js",
    "start": "node server/server.js",
    "dev": "npm run build && node server/seed.js && node server/server.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.25.9",
    "@babel/preset-react": "^7.25.9"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "multer": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
